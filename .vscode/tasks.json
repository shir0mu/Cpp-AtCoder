{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "g++-16 build active file",
			"command": "g++-16",
			"args": [
				"-std=gnu++23",
				"-g",
				"-Wall",
				"-Wextra",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CheckTestCase",
			"type": "shell",
			"command": "cd ${fileDirname} && rm -f ${fileDirname}/${fileBasenameNoExtension} && g++-16 -std=gnu++23 -O2 -Wall -Wextra ${fileBasename} -o ${fileBasenameNoExtension} && oj test -c \"${fileDirname}/${fileBasenameNoExtension}\" -d ${fileDirname}/test/",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "SubmitCode",
			"type": "shell",
			"command": "cd ${fileDirname} && acc submit ${fileBasename} -- -l 6017 -y",
			"presentation": {
			"reveal": "always",
			"focus": true,
				"panel": "shared"
			}
		}
	]
}